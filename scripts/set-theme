#!/bin/bash

if [ -z "$1" ]; then
    echo "Usage: set-theme /path/to/image.jpg"
    exit 1
fi

# Generate colors
wal -q -n -i "$1"

pywalfox update

mkdir -p "$HOME/.config/gtk-4.0"
cp "$HOME/.cache/wal/colors-gtk4.css" "$HOME/.config/gtk-4.0/gtk.css"

# Gracefully restart Nautilus in the background to apply the new CSS
killall nautilus >/dev/null 2>&1

# Animate new wallpaper with swww
awww img "$1" --transition-type wipe --transition-angle 30 --transition-step 90 --transition-duration 1.5

# Load Pywal colors
source "$HOME/.cache/wal/colors.sh"

# Update MangoWM config.conf borders (formatted as 0xRRGGBBff)
sed -i "s/^focuscolor=.*/focuscolor=0x${color2:1}ff/" "$HOME/.config/mango/config.conf"
sed -i "s/^bordercolor=.*/bordercolor=0x${background:1}ff/" "$HOME/.config/mango/config.conf"
  
# Force Wayland variables so Waybar can talk to the display
export XDG_RUNTIME_DIR=/run/user/$(id -u)
export WAYLAND_DISPLAY=wayland-1

sleep 0.5

# Run the reload command and catch the exact error if it fails
mmsg -s -d reload_config

#Reload Waybar
killall -SIGUSR2 waybar

# Update SDDM Corners Theme
source "$HOME/.cache/wal/colors.sh"
SDDM_DIR="/usr/share/sddm/themes/corners"

# 1. Copy the wallpaper so SDDM can read it
cp -f "$1" "$SDDM_DIR/pywal_bg.jpg"

# 2. Generate a complete override file
cat << EOF > "$SDDM_DIR/theme.conf.user"
[General]
BgSource="/usr/share/sddm/themes/corners/pywal_bg.jpg"
InputColor="$background"
InputTextColor="$foreground"
InputBorderColor="$color2"
LoginButtonColor="$color4"
LoginButtonTextColor="$background"
PopupColor="$background"
PopupActiveColor="$color4"
PopupActiveTextColor="$background"
UserBorderColor="$color2"
DateColor="$foreground"
TimeColor="$foreground"
SessionButtonColor="$color2"
SessionIconColor="$background"
PowerButtonColor="$color2"
PowerIconColor="$background"
EOF
