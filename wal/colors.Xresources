! X colors.
! Generated by 'wal'
*foreground:        #b2c0dc
*background:        #0c0b11
*.foreground:       #b2c0dc
*.background:       #0c0b11
emacs*foreground:   #b2c0dc
emacs*background:   #0c0b11
URxvt*foreground:   #b2c0dc
XTerm*foreground:   #b2c0dc
UXTerm*foreground:  #b2c0dc
URxvt*background:   [100]#0c0b11
XTerm*background:   #0c0b11
UXTerm*background:  #0c0b11
URxvt*cursorColor:  #b2c0dc
XTerm*cursorColor:  #b2c0dc
UXTerm*cursorColor: #b2c0dc
URxvt*borderColor:  [100]#0c0b11

! Colors 0-15.
*.color0: #0c0b11
*color0:  #0c0b11
*.color1: #505266
*color1:  #505266
*.color2: #58688E
*color2:  #58688E
*.color3: #6D7291
*color3:  #6D7291
*.color4: #61739D
*color4:  #61739D
*.color5: #837C91
*color5:  #837C91
*.color6: #7285B4
*color6:  #7285B4
*.color7: #b2c0dc
*color7:  #b2c0dc
*.color8: #7c869a
*color8:  #7c869a
*.color9: #505266
*color9:  #505266
*.color10: #58688E
*color10:  #58688E
*.color11: #6D7291
*color11:  #6D7291
*.color12: #61739D
*color12:  #61739D
*.color13: #837C91
*color13:  #837C91
*.color14: #7285B4
*color14:  #7285B4
*.color15: #b2c0dc
*color15:  #b2c0dc

! Black color that will not be affected by bold highlighting.
*.color66: #0c0b11
*color66:  #0c0b11

! Xclock colors.
XClock*foreground: #b2c0dc
XClock*background: #0c0b11
XClock*majorColor:  rgba:b2/c0/dc/ff
XClock*minorColor:  rgba:b2/c0/dc/ff
XClock*hourColor:   rgba:b2/c0/dc/ff
XClock*minuteColor: rgba:b2/c0/dc/ff
XClock*secondColor: rgba:b2/c0/dc/ff

! Set depth to make transparency work.
URxvt*depth: 32
